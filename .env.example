# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared Google Gemini key (optional fallback).
# Each user can instead add their own key in Settings -> Your API keys.
# Also powers AI lead discovery through Google Search grounding.
# Discovery falls back to the free OpenStreetMap directory when Gemini is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared email delivery (optional fallback).
# Each user can instead add their own Resend key + verified sender in Settings.
RESEND_API_KEY=
EMAIL_FROM="LeadPilot <you@yourdomain.com>"
EMAIL_REPLY_TO=

# SMTP fallback (used only when no Resend key is available)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Public app URL (used for metadata, auth redirects, PWA).
# Set this to your deployed URL in Vercel, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
